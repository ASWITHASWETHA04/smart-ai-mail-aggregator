# ==============================================================================
# SmartMail AI — Backend Environment Configuration Template
# DO NOT place real production secrets or API keys in this file.
# Copy to .env and configure local development values.
# In AWS ECS Fargate, these values are populated from AWS Secrets Manager / SSM.
# ==============================================================================

# Flask Server Configuration
FLASK_ENV=development
FLASK_DEBUG=1
PORT=5000
SECRET_KEY=change-me-to-a-secure-random-secret-key-in-production

# CORS Allowed Origins (Comma-separated list; wildcard '*' is forbidden in production)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8080

# Database Persistence
# Local Development: sqlite:///smartmail.db
# Production (Amazon RDS PostgreSQL): postgresql://dbuser:dbpass@rds-endpoint.region.rds.amazonaws.com:5432/smartmail_db
DATABASE_URL=sqlite:///smartmail.db

# Database Connection Pool Settings (Amazon RDS PostgreSQL)
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800

# Authentication & JWT Configuration
JWT_SECRET_KEY=change-me-to-a-secure-jwt-secret-in-production
JWT_ACCESS_TOKEN_EXPIRES_MINUTES=60

# Rate Limiting Configuration
# Local/Test: memory://
# Production (Amazon ElastiCache Redis): redis://elasticache-endpoint.region.cache.amazonaws.com:6379/0
# Production with In-Transit Encryption (TLS): rediss://:auth_token@elasticache-endpoint.region.cache.amazonaws.com:6379/0
RATELIMIT_STORAGE_URI=memory://

# AI Engineering Module (OpenAI Python SDK)
# Optional in test environments; required for live email generation
OPENAI_API_KEY=placeholder_openai_api_key_for_testing
OPENAI_MODEL=gpt-4o-mini
OPENAI_TIMEOUT_SECONDS=30
OPENAI_MAX_RETRIES=2

# Cloud Engineering Module (AWS Staging / Production Context)
AWS_REGION=us-east-1
# Production Secret Identifier: smartmail-ai/production/credentials
# Staging Secret Identifier:    smartmail-ai/staging/credentials
AWS_SECRETS_MANAGER_SECRET_NAME=smartmail-ai/staging/credentials
# CloudWatch Log Group:
# Staging:    /ecs/smartmail-ai-staging
# Production: /ecs/smartmail-ai-production
CLOUDWATCH_LOG_GROUP=/ecs/smartmail-ai-staging

