# SmartMail AI — Frontend Environment Configuration Template
# SECURITY NOTICE: Any variable prefixed with VITE_ is embedded into the client-side
# JavaScript bundle at build time and is publicly visible. NEVER put private keys,
# JWT secrets, database passwords, or OpenAI credentials in frontend environment files.

# API Base URL for backend REST endpoints (leave blank if frontend and backend share domain via ALB/CloudFront)
VITE_API_BASE_URL=http://localhost:5000
